<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputPath>..\bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Title>PluginInterface</Title>
    <Company>TransposonY</Company>
    <Product>PluginInterface</Product>
    <Copyright>Copyright ©  TransposonY 2022</Copyright>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'uiAccessRelease'">
    <DefineConstants>$(DefineConstants);uiAccess</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Centennial'">
    <DefineConstants>$(DefineConstants);ConvertedDesktopApp</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Portable'">
    <DefineConstants>$(DefineConstants);Portable</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\GestureSign.PointPatterns\GestureSign.PointPatterns.csproj" />
    <ProjectReference Include="..\ManagedWinapi\ManagedWinapi.csproj" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
