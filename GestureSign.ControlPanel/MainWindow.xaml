<common:TouchWindow x:Class="GestureSign.ControlPanel.MainWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:localization="clr-namespace:GestureSign.Common.Localization;assembly=GestureSign.Common"
                    xmlns:common="clr-namespace:GestureSign.ControlPanel.Common"
                    xmlns:mainWindowControl="clr-namespace:GestureSign.ControlPanel.MainWindowControls"
                    xmlns:controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                    FlowDirection="{StaticResource DefaultFlowDirection}"
                    Title="{localization:LocalisedText Title}"
                    Height="700"
                    Width="1120"
                    ShowIconOnTitleBar="False"
                    ShowTitleBar="True"
                    TitleBarHeight="32"
                    TitleAlignment="Center"
                    TitleCharacterCasing="Normal"
                    TitleForeground="White"
                    WindowTitleBrush="{StaticResource UiChromeBrush}"
                    NonActiveWindowTitleBrush="{StaticResource UiChromeInactiveBrush}"
                    Icon="Resources/normal.ico"
                    BorderThickness="1"
                    BorderBrush="{StaticResource UiChromeBrush}"
                    NonActiveBorderBrush="{StaticResource UiChromeInactiveBrush}"
                    Foreground="{StaticResource UiInkBrush}"
                    MinWidth="900"
                    MinHeight="560"
                    Loaded="MetroWindow_Loaded">
    <controls:MetroWindow.LeftWindowCommands>
        <controls:WindowCommands ShowSeparators="False">
            <Image Source="{StaticResource Icon.AppGlyph}"
                   Width="18"
                   Height="18"
                   Margin="12,0,8,0" />
            <Button Click="QuickExport_Click"
                    ToolTip="{localization:LocalisedText Common.Export}"
                    Opacity="1"
                    Width="34">
                <Image Source="{StaticResource Icon.ExportSmallWhite}"
                       Width="16"
                       Height="16" />
            </Button>
            <Button Click="QuickImport_Click"
                    ToolTip="{localization:LocalisedText Common.Import}"
                    Opacity="1"
                    Width="34">
                <Image Source="{StaticResource Icon.ImportSmallWhite}"
                       Width="16"
                       Height="16" />
            </Button>
        </controls:WindowCommands>
    </controls:MetroWindow.LeftWindowCommands>
    <controls:MetroWindow.RightWindowCommands>
        <controls:WindowCommands ShowSeparators="False">
            <Button Click="Hyperlink_Click"
                    CommandParameter="{localization:LocalisedText About.HelpPageUrl}"
                    Opacity="1"
                    Width="46">
                <Image Source="{StaticResource Icon.HelpWhite}"
                       Width="14"
                       Height="14" />
            </Button>
            <!-- Keeps Help visually apart from the system caption buttons -->
            <Rectangle Width="1"
                       Height="16"
                       Margin="0,0,2,0"
                       Fill="#59FFFFFF" />
        </controls:WindowCommands>
    </controls:MetroWindow.RightWindowCommands>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <TabControl x:Name="MainTabs"
                        Style="{StaticResource OfficeTabControl}">
                <TabItem Header="{localization:LocalisedText Action.Header}">
                    <mainWindowControl:AvailableActions x:Name="AvailableActions" />
                </TabItem>
                <TabItem Header="{localization:LocalisedText Ignored.Header}">
                    <mainWindowControl:IgnoredApplications x:Name="ignoredApplications" />
                </TabItem>
                <TabItem Header="{localization:LocalisedText Gesture.Header}">
                    <mainWindowControl:AvailableGestures x:Name="availableGestures" />
                </TabItem>
                <TabItem Header="{localization:LocalisedText ContinuousGesture.Header}">
                    <mainWindowControl:ContinuousGestures x:Name="continuousGestures" />
                </TabItem>
                <TabItem Header="{localization:LocalisedText Options.Header}">
                    <!-- The page carries its own ribbon (user data) -->
                    <mainWindowControl:Options />
                </TabItem>
                <TabItem Header="{localization:LocalisedText About.Header}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource RibbonRail}" />
                        <ScrollViewer Grid.Row="1"
                                      PanningMode="VerticalFirst">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap"
                                           Text="GestureSign"
                                           Margin="15,10,0,0"
                                           FontWeight="Bold"
                                           FontSize="16" />
                                <TextBlock HorizontalAlignment="Left"
                                           FontSize="14"
                                           Margin="15,10,0,0">
                                    <Hyperlink Click="Hyperlink_Click"
                                               CommandParameter="{localization:LocalisedText About.HomepageUrl}">
                                        <Run Text="{localization:LocalisedText About.Homepage}" />
                                    </Hyperlink>
                                    <Run Text="/" />
                                    <Hyperlink Click="Hyperlink_Click"
                                               CommandParameter="ms-windows-store://pdp/?productid=9n45wqvk2qqw">
                                        <Run Text="{localization:LocalisedText About.Store}" />
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock HorizontalAlignment="Left"
                                           FontSize="14"
                                           Margin="15,10,0,0">
                                    <Hyperlink Click="SendFeedback_Click">
                                        <Run Text="{localization:LocalisedText About.SendFeedback}" />
                                    </Hyperlink>
                                </TextBlock>
                                <TextBox x:Name="AboutTextBox"
                                         HorizontalAlignment="Left"
                                         Margin="10,10,0,0"
                                         BorderThickness="0"
                                         IsReadOnly="True"
                                         Text="{localization:LocalisedText About.Information}" />
                                <TextBox  HorizontalAlignment="Left"
                                          Margin="10,10,0,0"
                                          Text="Project Page&#xA;https://github.com/TransposonY/GestureSign&#xA;&#xA;Thanks to the following project:&#xA;http://highsign.codeplex.com/&#xA;License:http://highsign.codeplex.com/license&#xA;&#xA;MahApps.Metro&#xA;https://github.com/MahApps/MahApps.Metro&#xA;License:http://www.opensource.org/licenses/MS-PL&#xA;&#xA;WGestures&#xA;https://github.com/yingDev/WGestures&#xA;License:https://github.com/yingDev/WGestures/blob/master/LICENSE"
                                          VerticalAlignment="Top"
                                          BorderThickness="0"
                                          IsReadOnly="True"
                                          Width="319" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Search lives on the tab strip; it only applies to the Action list -->
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,4,10,0"
                    Width="300"
                    Height="24"
                    Background="White"
                    CornerRadius="2">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=MainTabs, Path=SelectedIndex}"
                                         Value="0">
                                <Setter Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Source="{StaticResource Icon.Search}"
                           Width="14"
                           Height="14"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />
                    <TextBox x:Name="ActionSearchTextBox"
                             Grid.Column="1"
                             Height="24"
                             FontSize="12"
                             Margin="2,0,0,0"
                             Padding="0"
                             VerticalContentAlignment="Center"
                             BorderThickness="0"
                             Background="Transparent"
                             controls:TextBoxHelper.Watermark="{localization:LocalisedText Action.Search}"
                             Text="{Binding ElementName=AvailableActions, Path=SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <!-- Only offered while there is something to clear -->
                    <Button Grid.Column="2"
                            Width="24"
                            Height="24"
                            OverridesDefaultStyle="True"
                            Focusable="False"
                            Background="Transparent"
                            Click="ClearSearch_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="2">
                                                <Path Data="M0,0 L8,8 M8,0 L0,8"
                                                      Stroke="{StaticResource UiMutedBrush}"
                                                      StrokeThickness="1.2"
                                                      Width="8"
                                                      Height="8"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                    <Setter Property="Background"
                                                            Value="{StaticResource UiRibbonBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=ActionSearchTextBox, Path=Text}"
                                                 Value="">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="1"
                Height="24"
                Background="{StaticResource UiChromeBrush}"
                TextElement.Foreground="White"
                TextElement.FontSize="12">
            <DockPanel Margin="12,0">
                <!-- Right side: the selected application on the Action tab, otherwise the tab's own name -->
                <Grid DockPanel.Dock="Right"
                      VerticalAlignment="Center">
                    <TextBlock Text="{Binding ElementName=AvailableActions, Path=StatusApplicationText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=MainTabs, Path=SelectedIndex}"
                                                 Value="0">
                                        <Setter Property="Visibility"
                                                Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding ElementName=MainTabs, Path=SelectedItem.Header}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=MainTabs, Path=SelectedIndex}"
                                                 Value="0">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=MainTabs, Path=SelectedIndex}"
                                             Value="0">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding ElementName=AvailableActions, Path=StatusActionCountText}" />
                    <TextBlock Margin="20,0,0,0"
                               Text="{Binding ElementName=AvailableActions, Path=StatusFingersText}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</common:TouchWindow>
