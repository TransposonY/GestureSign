<UserControl x:Class="GestureSign.ControlPanel.MainWindowControls.AvailableGestures"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:localization="clr-namespace:GestureSign.Common.Localization;assembly=GestureSign.Common"
             xmlns:viewModel="clr-namespace:GestureSign.ControlPanel.ViewModel"
             xmlns:converters="clr-namespace:GestureSign.ControlPanel.Converters"
             xmlns:componentmodel="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             xmlns:controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             mc:Ignorable="d"
             d:DesignHeight="400"
             d:DesignWidth="450"
             AllowDrop="True">
    <UserControl.Resources>
        <converters:GroupHeaderConverter x:Key="GroupHeaderConverter" />
        <CollectionViewSource x:Key="GestureViewSource"
                              Filter="GestureViewSource_Filter"
                              Source="{Binding Path=(viewModel:GestureItemProvider.GestureItems)}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="PatternCount" />
            </CollectionViewSource.GroupDescriptions>
            <CollectionViewSource.SortDescriptions>
                <componentmodel:SortDescription PropertyName="PatternCount"
                                                Direction="Ascending" />
                <componentmodel:SortDescription PropertyName="Features"
                                                Direction="Ascending" />
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
        <ItemsPanelTemplate x:Key="IconPanelTemplate">
            <WrapPanel IsItemsHost="True" />
        </ItemsPanelTemplate>
        <!-- Tile: just the drawn gesture; the description and applications appear on hover -->
        <DataTemplate x:Key="IconTemplate">
            <Grid Width="128"
                  Height="76"
                  Background="Transparent">
                <Grid.ToolTip>
                    <StackPanel>
                        <TextBlock Text="{Binding Path=Description}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Path=Applications}"
                                   Foreground="{StaticResource UiMutedBrush}"
                                   Margin="0,2,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=Applications}"
                                                     Value="">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid.ToolTip>
                <Image Source="{Binding Path=GestureImage}"
                       Margin="6"
                       Stretch="Uniform"
                       StretchDirection="DownOnly"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <Style x:Key="GestureTileItem"
               TargetType="{x:Type ListViewItem}">
            <Setter Property="OverridesDefaultStyle"
                    Value="True" />
            <Setter Property="Margin"
                    Value="4" />
            <EventSetter Event="MouseDoubleClick"
                         Handler="ListViewItem_OnMouseDoubleClick" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border x:Name="Bd"
                                Background="White"
                                BorderBrush="{StaticResource UiRuleBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="{StaticResource UiRibbonHoverBorderBrush}" />
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{StaticResource UiHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{StaticResource UiSelectedBrush}" />
                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="{StaticResource UiChromeBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <GridView x:Key="GridView">
            <GridViewColumn>
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <Image Height="45"
                               MaxWidth="220"
                               Margin="5"
                               Stretch="Uniform"
                               StretchDirection="DownOnly"
                               Source="{Binding Path=GestureImage}" />
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
                <GridViewColumnHeader Content="{localization:LocalisedText Gesture.Header}"
                                      Tag="Features" />
            </GridViewColumn>
            <GridViewColumn DisplayMemberBinding="{Binding Path=Description}">
                <GridViewColumnHeader Content="{localization:LocalisedText Gesture.DescriptionColumn}"
                                      Tag="Description" />
            </GridViewColumn>
            <GridViewColumn DisplayMemberBinding="{Binding Path=Applications}">
                <GridViewColumnHeader Content="{localization:LocalisedText Gesture.Applications}"
                                      Tag="Applications" />
            </GridViewColumn>
        </GridView>
        <!-- Details view rows -->
                <Style x:Key="GestureRowItem"
                       TargetType="{x:Type ListViewItem}"
                       BasedOn="{StaticResource {x:Type ListViewItem}}">
                    <EventSetter Event="MouseDoubleClick"
                                 Handler="ListViewItem_OnMouseDoubleClick" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListViewItem}">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        SnapsToDevicePixels="true">
                                    <Grid>
                                        <GridViewRowPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                            <GridViewRowPresenter.Resources>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Foreground"
                                                            Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}, Path=Foreground}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"
                                                                     Value="True">
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource UiInkBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Path=IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                                     Value="False">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource GrayNormalBrush}" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Path=IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                                           Value="False" />
                                                                <Condition Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"
                                                                           Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <MultiDataTrigger.Setters>
                                                                <Setter Property="Foreground"
                                                                        Value="{StaticResource UiInkBrush}" />
                                                            </MultiDataTrigger.Setters>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </GridViewRowPresenter.Resources>
                                        </GridViewRowPresenter>
                                        <ContentPresenter x:Name="contentPresenter"
                                                          Visibility="Collapsed"
                                                          Margin="{TemplateBinding Padding}"
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="GridView.ColumnCollection"
                                             Value="{x:Null}">
                                        <Setter TargetName="contentPresenter"
                                                Property="Visibility"
                                                Value="Visible" />
                                    </Trigger>
                                    <Trigger Property="IsSelected"
                                             Value="true">
                                        <Setter Property="Foreground"
                                                Value="{StaticResource UiInkBrush}" />
                                        <Setter TargetName="Bd"
                                                Property="Background"
                                                Value="{StaticResource UiSelectedBrush}" />
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsEnabled"
                                                       Value="False" />
                                            <Condition Property="IsSelected"
                                                       Value="True" />
                                        </MultiTrigger.Conditions>
                                        <MultiTrigger.Setters>
                                            <Setter TargetName="Bd"
                                                    Property="Background"
                                                    Value="{DynamicResource GrayBrush7}" />
                                        </MultiTrigger.Setters>
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Ribbon -->
        <Border Height="96"
                Background="{StaticResource UiRibbonBrush}"
                BorderBrush="{StaticResource UiRuleBrush}"
                BorderThickness="0,0,0,1"
                Padding="6,0">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource RibbonGroup}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="20" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,8,0,0">
                            <Button x:Name="btnEditGesture"
                                    Style="{StaticResource RibbonSmallButton}"
                                    Click="btnEditGesture_Click"
                                    IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{StaticResource Icon.Edit}"
                                           Width="16"
                                           Height="16" />
                                    <TextBlock Style="{StaticResource RibbonSmallCaption}"
                                               Text="{localization:LocalisedText Action.Edit}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnDelGesture"
                                    Style="{StaticResource RibbonSmallButton}"
                                    Margin="0,2,0,0"
                                    Click="btnDelGesture_Click"
                                    IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{StaticResource Icon.Delete}"
                                           Width="16"
                                           Height="16" />
                                    <TextBlock Style="{StaticResource RibbonSmallCaption}"
                                               Text="{localization:LocalisedText Action.Delete}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Style="{StaticResource RibbonGroupCaption}"
                                   Text="{localization:LocalisedText Gesture.Header}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource RibbonGroup}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="20" />
                        </Grid.RowDefinitions>
                        <Button x:Name="ImportButton"
                                Style="{StaticResource RibbonLargeButton}"
                                MinWidth="56"
                                Margin="0,4,0,0"
                                Click="ImportGestureMenuItem_Click">
                            <StackPanel>
                                <Image Source="{StaticResource Icon.ImportLarge}"
                                       Width="32"
                                       Height="32" />
                                <TextBlock Style="{StaticResource RibbonLargeCaption}"
                                           Text="{localization:LocalisedText ExportImportDialog.ImportButton}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Row="1"
                                   Style="{StaticResource RibbonGroupCaption}"
                                   Text="{localization:LocalisedText Action.RibbonBackup}" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
        <!-- Filter bar: input (fingers) and shape chips, application and description search -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource UiRuleBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="210" />
                </Grid.ColumnDefinitions>

                <!-- Input -->
                <TextBlock Style="{StaticResource FilterLabel}"
                           Text="{localization:LocalisedText Gesture.Filter.Input}" />
                <Border Grid.Column="1"
                        Background="{StaticResource UiRibbonBrush}"
                        BorderBrush="{StaticResource UiRuleBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="1">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="AllFingersRadio"
                                     Style="{StaticResource FilterSegment}"
                                     GroupName="GestureFingerFilter"
                                     IsChecked="True"
                                     Tag="0"
                                     Checked="FingerFilter_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{localization:LocalisedText Gesture.Filter.All}" />
                                <TextBlock x:Name="AllFingersCount"
                                           Margin="6,0,0,0"
                                           FontSize="12"
                                           Opacity="0.7" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="OneFingerRadio"
                                     Style="{StaticResource FilterSegment}"
                                     GroupName="GestureFingerFilter"
                                     Tag="1"
                                     Checked="FingerFilter_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{localization:LocalisedText Gesture.Filter.MouseOrOneFinger}" />
                                <TextBlock x:Name="OneFingerCount"
                                           Margin="6,0,0,0"
                                           FontSize="12"
                                           Opacity="0.7" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TwoFingersRadio"
                                     Style="{StaticResource FilterSegment}"
                                     GroupName="GestureFingerFilter"
                                     Tag="2"
                                     Checked="FingerFilter_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TwoFingersLabel" />
                                <TextBlock x:Name="TwoFingersCount"
                                           Margin="6,0,0,0"
                                           FontSize="12"
                                           Opacity="0.7" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ThreeFingersRadio"
                                     Style="{StaticResource FilterSegment}"
                                     GroupName="GestureFingerFilter"
                                     Tag="3"
                                     Checked="FingerFilter_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ThreeFingersLabel" />
                                <TextBlock x:Name="ThreeFingersCount"
                                           Margin="6,0,0,0"
                                           FontSize="12"
                                           Opacity="0.7" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="FourFingersRadio"
                                     Style="{StaticResource FilterSegment}"
                                     GroupName="GestureFingerFilter"
                                     Tag="4"
                                     Checked="FingerFilter_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="FourFingersLabel" />
                                <TextBlock x:Name="FourFingersCount"
                                           Margin="6,0,0,0"
                                           FontSize="12"
                                           Opacity="0.7" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="FiveFingersRadio"
                                     Style="{StaticResource FilterSegment}"
                                     GroupName="GestureFingerFilter"
                                     Tag="5"
                                     Checked="FingerFilter_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{localization:LocalisedText Gesture.Filter.FiveOrMoreFingers}" />
                                <TextBlock x:Name="FiveFingersCount"
                                           Margin="6,0,0,0"
                                           FontSize="12"
                                           Opacity="0.7" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <ComboBox x:Name="ApplicationFilterBox"
                          Grid.Column="3"
                          Height="30"
                          ToolTip="{localization:LocalisedText Gesture.Filter.UsedBy}"
                          SelectionChanged="ApplicationFilter_SelectionChanged" />

                <!-- Shape -->
                <TextBlock Grid.Row="1"
                           Margin="0,10,0,0"
                           Style="{StaticResource FilterLabel}"
                           Text="{localization:LocalisedText Gesture.Filter.Shape}" />
                <StackPanel Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,10,0,0"
                            Orientation="Horizontal">
                    <RadioButton x:Name="AnyShapeRadio"
                                 Style="{StaticResource FilterChip}"
                                 Content="{localization:LocalisedText Gesture.Filter.AnyShape}"
                                 GroupName="GestureShapeFilter"
                                 IsChecked="True"
                                 Tag="Any"
                                 Checked="ShapeFilter_Checked" />
                    <RadioButton Style="{StaticResource FilterChip}"
                                 Content="{localization:LocalisedText Gesture.Filter.Line}"
                                 GroupName="GestureShapeFilter"
                                 Tag="Line"
                                 Checked="ShapeFilter_Checked" />
                    <RadioButton Style="{StaticResource FilterChip}"
                                 Content="{localization:LocalisedText Gesture.Filter.Curve}"
                                 GroupName="GestureShapeFilter"
                                 Tag="Curve"
                                 Checked="ShapeFilter_Checked" />
                    <RadioButton Style="{StaticResource FilterChip}"
                                 Content="{localization:LocalisedText Gesture.Filter.Loop}"
                                 GroupName="GestureShapeFilter"
                                 Tag="Loop"
                                 Checked="ShapeFilter_Checked" />
                    <!-- Independent of the shape: combine it with any chip to its left -->
                    <ToggleButton x:Name="DotToggle"
                                  Style="{StaticResource FilterToggleChip}"
                                  Margin="10,0,0,0"
                                  ToolTip="{localization:LocalisedText Gesture.Filter.WithDotInfo}"
                                  Checked="DotFilter_Changed"
                                  Unchecked="DotFilter_Changed">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7"
                                     Height="7"
                                     Margin="0,0,8,0"
                                     Fill="{StaticResource UiChromeBrush}" />
                            <TextBlock Text="{localization:LocalisedText Gesture.Filter.WithDot}" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
                <StackPanel Grid.Row="1"
                            Grid.Column="2"
                            Margin="0,10,12,0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="ResultCountText"
                               Style="{StaticResource FilterLabel}" />
                    <Button x:Name="ClearFiltersButton"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Padding="0"
                            Cursor="Hand"
                            Focusable="False"
                            OverridesDefaultStyle="True"
                            Visibility="Collapsed"
                            Click="ClearFilters_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock x:Name="Caption"
                                           FontSize="12"
                                           Foreground="{StaticResource UiChromeBrush}"
                                           Text="{localization:LocalisedText Gesture.Filter.Clear}" />
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter TargetName="Caption"
                                                Property="TextDecorations"
                                                Value="Underline" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
                <Border Grid.Row="1"
                        Grid.Column="3"
                        Margin="0,10,0,0"
                        Height="30"
                        Background="White"
                        BorderBrush="{StaticResource UiRuleBrush}"
                        BorderThickness="1"
                        CornerRadius="3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="{StaticResource Icon.Search}"
                               Width="14"
                               Height="14"
                               Margin="9,0,0,0"
                               VerticalAlignment="Center" />
                        <TextBox x:Name="DescriptionSearchBox"
                                 Grid.Column="1"
                                 Margin="4,0,0,0"
                                 Padding="0"
                                 FontSize="12"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 controls:TextBoxHelper.Watermark="{localization:LocalisedText Gesture.Filter.SearchDescription}"
                                 TextChanged="DescriptionSearch_TextChanged" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <TextBlock x:Name="NoMatchesText"
                   Grid.Row="2"
                   Margin="0,40,0,0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Foreground="{StaticResource UiMutedBrush}"
                   Text="{localization:LocalisedText Gesture.Filter.NoMatches}"
                   Visibility="Collapsed" />
        <ListView x:Name="lstAvailableGestures"
                  Grid.Row="2"
                  ItemsSource="{Binding Source={StaticResource GestureViewSource}}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.PanningMode="VerticalOnly"
                  SelectionChanged="lstAvailableGestures_SelectionChanged"
                  GridViewColumnHeader.Click="GridViewColumnHeaderClickedHandler"
                  BorderThickness="0"
                  SelectedValuePath="Gesture">
            <ListView.Style>
                <Style TargetType="ListView"
                       BasedOn="{StaticResource {x:Type ListView}}">
                    <Setter Property="ItemContainerStyle"
                            Value="{StaticResource GestureTileItem}" />
                    <Setter Property="Background"
                            Value="{StaticResource UiRibbonBrush}" />
                    <Setter Property="Padding"
                            Value="12,0,12,8" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=LargeIconsMenuItem, Path=IsChecked}"
                                     Value="True">
                            <Setter Property="View"
                                    Value="{x:Null}" />
                            <Setter Property="ItemsPanel"
                                    Value="{DynamicResource IconPanelTemplate}" />
                            <Setter Property="ItemTemplate"
                                    Value="{StaticResource IconTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ElementName=DetailsMenuItem, Path=IsChecked}"
                                     Value="True">
                            <Setter Property="View"
                                    Value="{DynamicResource GridView}" />
                            <Setter Property="ItemContainerStyle"
                                    Value="{StaticResource GestureRowItem}" />
                            <Setter Property="Background"
                                    Value="White" />
                            <Setter Property="Padding"
                                    Value="0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.Style>
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                        <Expander Style="{StaticResource NavExpander}">
                                            <Expander.Header>
                                                <DockPanel>
                                                    <TextBlock FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource UiInkBrush}"
                                                               Margin="0"
                                                               HorizontalAlignment="Left"
                                                               DockPanel.Dock="Top">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource GroupHeaderConverter}">
                                                                <Binding  Path="Name"
                                                                          Mode="OneWay" />
                                                                <Binding  Path="ItemCount"
                                                                          Mode="OneWay" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </DockPanel>
                                            </Expander.Header>
                                            <Expander.Content>
                                                <ItemsPresenter />
                                            </Expander.Content>
                                        </Expander>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="ViewMenuItem"
                              Header="{localization:LocalisedText Gesture.View}"
                              FontSize="16">
                        <MenuItem x:Name="LargeIconsMenuItem"
                                  Header="{localization:LocalisedText Gesture.LargeIcons}"
                                  FontSize="16"
                                  IsCheckable="True"
                                  IsChecked="True"
                                  Click="ViewMenuItem_Click" />
                        <MenuItem x:Name="DetailsMenuItem"
                                  Header="{localization:LocalisedText Gesture.Details}"
                                  FontSize="16"
                                  IsCheckable="True"
                                  Click="ViewMenuItem_Click" />
                    </MenuItem>
                    <Separator />
                    <MenuItem x:Name="ImportGestureMenuItem"
                              Header="{localization:LocalisedText Gesture.ImportGesture}"
                              Click="ImportGestureMenuItem_Click"
                              FontSize="16" />
                </ContextMenu>
            </ListView.ContextMenu>
        </ListView>
    </Grid>
</UserControl>
