    <!-- ===== Ribbon buttons ===== -->
    <Style x:Key="RibbonButtonBase"
           TargetType="ButtonBase">
        <Setter Property="OverridesDefaultStyle"
                Value="True" />
        <Setter Property="FontSize"
                Value="12" />
        <Setter Property="Foreground"
                Value="{StaticResource UiInkBrush}" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderBrush"
                Value="Transparent" />
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
    </Style>

    <ControlTemplate x:Key="RibbonButtonTemplate"
                     TargetType="ButtonBase">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1"
                CornerRadius="2"
                Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter TargetName="Bd"
                        Property="Background"
                        Value="{StaticResource UiRibbonHoverBrush}" />
                <Setter TargetName="Bd"
                        Property="BorderBrush"
                        Value="{StaticResource UiRibbonHoverBorderBrush}" />
            </Trigger>
            <Trigger Property="IsPressed"
                     Value="True">
                <Setter TargetName="Bd"
                        Property="Background"
                        Value="{StaticResource UiChipBrush}" />
                <Setter TargetName="Bd"
                        Property="BorderBrush"
                        Value="{StaticResource UiAccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled"
                     Value="False">
                <Setter Property="Opacity"
                        Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Large: 32px icon over a centred caption -->
    <Style x:Key="RibbonLargeButton"
           TargetType="Button"
           BasedOn="{StaticResource RibbonButtonBase}">
        <Setter Property="Padding"
                Value="6,3,6,0" />
        <Setter Property="MinWidth"
                Value="52" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Top" />
        <Setter Property="Template"
                Value="{StaticResource RibbonButtonTemplate}" />
    </Style>

    <!-- Small: 16px icon beside a caption, stacked two or three to a column -->
    <Style x:Key="RibbonSmallButton"
           TargetType="Button"
           BasedOn="{StaticResource RibbonButtonBase}">
        <Setter Property="Padding"
                Value="6,0,8,0" />
        <Setter Property="Height"
                Value="22" />
        <Setter Property="MinWidth"
                Value="72" />
        <Setter Property="HorizontalContentAlignment"
                Value="Left" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="Template"
                Value="{StaticResource RibbonButtonTemplate}" />
    </Style>

    <!-- Ribbon group: content on top, caption underneath, hairline on the right -->
    <Style x:Key="RibbonGroup"
           TargetType="Border">
        <Setter Property="BorderBrush"
                Value="{StaticResource UiRuleBrush}" />
        <Setter Property="BorderThickness"
                Value="0,0,1,0" />
        <Setter Property="Padding"
                Value="6,0" />
    </Style>
    <Style x:Key="RibbonGroupCaption"
           TargetType="TextBlock">
        <Setter Property="FontSize"
                Value="11" />
        <Setter Property="Foreground"
                Value="{StaticResource UiMutedBrush}" />
        <Setter Property="HorizontalAlignment"
                Value="Center" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>
    <Style x:Key="RibbonLargeCaption"
           TargetType="TextBlock">
        <Setter Property="TextAlignment"
                Value="Center" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="MaxWidth"
                Value="72" />
        <Setter Property="LineHeight"
                Value="14" />
        <Setter Property="LineStackingStrategy"
                Value="BlockLineHeight" />
        <Setter Property="Margin"
                Value="0,3,0,0" />
    </Style>
    <Style x:Key="RibbonSmallCaption"
           TargetType="TextBlock">
        <Setter Property="Margin"
                Value="6,0,0,0" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>

    <!-- Finger-count chip: a tall, quiet target that fills in when selected -->
    <Style x:Key="RibbonChip"
           TargetType="RadioButton">
        <Setter Property="OverridesDefaultStyle"
                Value="True" />
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="Foreground"
                Value="{StaticResource UiInkBrush}" />
        <Setter Property="Width"
                Value="32" />
        <Setter Property="Height"
                Value="56" />
        <Setter Property="Margin"
                Value="1,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chip"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="Label"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Chip"
                                    Property="Background"
                                    Value="{StaticResource UiRibbonHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="Chip"
                                    Property="Background"
                                    Value="{StaticResource UiChipBrush}" />
                            <Setter TargetName="Chip"
                                    Property="BorderBrush"
                                    Value="{StaticResource UiAccentBrush}" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource UiChromeBrush}" />
                            <Setter Property="FontWeight"
                                    Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Opacity"
                                    Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Filter bar (Gesture tab) ===== -->
    <!-- Segment: one of a joined set, solid chrome blue when selected -->
    <Style x:Key="FilterSegment"
           TargetType="RadioButton">
        <Setter Property="OverridesDefaultStyle"
                Value="True" />
        <Setter Property="FocusVisualStyle"
                Value="{x:Null}" />
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="Foreground"
                Value="{StaticResource UiInkBrush}" />
        <Setter Property="Height"
                Value="28" />
        <Setter Property="Margin"
                Value="1,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Seg"
                            Background="Transparent"
                            CornerRadius="3"
                            Padding="12,0"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Seg"
                                    Property="Background"
                                    Value="{StaticResource UiRibbonHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="Seg"
                                    Property="Background"
                                    Value="{StaticResource UiChromeBrush}" />
                            <Setter Property="Foreground"
                                    Value="White" />
                            <Setter Property="FontWeight"
                                    Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Opacity"
                                    Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chip: a pill with a hairline; soft blue fill and blue rim when on -->
    <ControlTemplate x:Key="FilterChipTemplate"
                     TargetType="ToggleButton">
        <Border x:Name="Chip"
                Background="White"
                BorderBrush="{StaticResource UiRuleBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="12,0"
                SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter TargetName="Chip"
                        Property="Background"
                        Value="{StaticResource UiHoverBrush}" />
                <Setter TargetName="Chip"
                        Property="BorderBrush"
                        Value="{StaticResource UiRibbonHoverBorderBrush}" />
            </Trigger>
            <Trigger Property="IsChecked"
                     Value="True">
                <Setter TargetName="Chip"
                        Property="Background"
                        Value="{StaticResource UiSelectedBrush}" />
                <Setter TargetName="Chip"
                        Property="BorderBrush"
                        Value="{StaticResource UiChromeBrush}" />
                <Setter Property="Foreground"
                        Value="{StaticResource UiChromeBrush}" />
                <Setter Property="FontWeight"
                        Value="SemiBold" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="FilterChip"
           TargetType="RadioButton">
        <Setter Property="OverridesDefaultStyle"
                Value="True" />
        <Setter Property="FocusVisualStyle"
                Value="{x:Null}" />
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="Foreground"
                Value="{StaticResource UiInkBrush}" />
        <Setter Property="Height"
                Value="28" />
        <Setter Property="Margin"
                Value="0,0,6,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chip"
                            Background="White"
                            BorderBrush="{StaticResource UiRuleBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="12,0"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Chip"
                                    Property="Background"
                                    Value="{StaticResource UiHoverBrush}" />
                            <Setter TargetName="Chip"
                                    Property="BorderBrush"
                                    Value="{StaticResource UiRibbonHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="Chip"
                                    Property="Background"
                                    Value="{StaticResource UiSelectedBrush}" />
                            <Setter TargetName="Chip"
                                    Property="BorderBrush"
                                    Value="{StaticResource UiChromeBrush}" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource UiChromeBrush}" />
                            <Setter Property="FontWeight"
                                    Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FilterToggleChip"
           TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle"
                Value="True" />
        <Setter Property="FocusVisualStyle"
                Value="{x:Null}" />
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="Foreground"
                Value="{StaticResource UiInkBrush}" />
        <Setter Property="Height"
                Value="28" />
        <Setter Property="Template"
                Value="{StaticResource FilterChipTemplate}" />
    </Style>

    <Style x:Key="FilterLabel"
           TargetType="TextBlock">
        <Setter Property="FontSize"
                Value="12" />
        <Setter Property="Foreground"
                Value="{StaticResource UiMutedBrush}" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>

    <!-- ===== Tab strip ===== -->
    <Style x:Key="OfficeTabItem"
           TargetType="TabItem">
        <Setter Property="OverridesDefaultStyle"
                Value="True" />
        <!-- The page inside a tab inherits these, so keep them neutral; header colours live on the template. -->
        <Setter Property="Foreground"
                Value="{StaticResource UiInkBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd"
                            Height="30"
                            VerticalAlignment="Bottom"
                            Padding="16,0"
                            Background="Transparent"
                            CornerRadius="2,2,0,0"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="HeaderSite"
                                          ContentSource="Header"
                                          TextElement.Foreground="White"
                                          TextElement.FontSize="13"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="#26FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsSelected"
                                 Value="True">
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{StaticResource UiRibbonBrush}" />
                            <Setter TargetName="HeaderSite"
                                    Property="TextElement.Foreground"
                                    Value="{StaticResource UiChromeBrush}" />
                            <Setter TargetName="HeaderSite"
                                    Property="TextElement.FontWeight"
                                    Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OfficeTabControl"
           TargetType="TabControl">
        <Setter Property="OverridesDefaultStyle"
                Value="True" />
        <Setter Property="Background"
                Value="White" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="ItemContainerStyle"
                Value="{StaticResource OfficeTabItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid ClipToBounds="True"
                          SnapsToDevicePixels="True"
                          KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="{StaticResource UiChromeBrush}"
                                Height="32"
                                Padding="8,0,0,0">
                            <TabPanel IsItemsHost="True"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Bottom"
                                      KeyboardNavigation.TabIndex="1"
                                      Background="Transparent" />
                        </Border>
                        <Border Grid.Row="1"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter ContentSource="SelectedContent"
                                              KeyboardNavigation.TabNavigation="Local"
                                              KeyboardNavigation.DirectionalNavigation="Contained" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Collapsible section header: chevron, small caps title, count on the right -->
    <Style x:Key="NavExpander"
           TargetType="Expander">
        <Setter Property="IsExpanded"
                Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <DockPanel>
                        <ToggleButton x:Name="HeaderButton"
                                      DockPanel.Dock="Top"
                                      OverridesDefaultStyle="True"
                                      Focusable="False"
                                      Height="36"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"
                                            BorderBrush="{StaticResource UiHairlineBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="12,0">
                                        <DockPanel>
                                            <Image x:Name="Chevron"
                                                   DockPanel.Dock="Left"
                                                   Source="{StaticResource Icon.Chevron}"
                                                   Width="10"
                                                   Height="10"
                                                   Margin="0,0,8,0"
                                                   RenderTransformOrigin="0.5,0.5">
                                                <Image.RenderTransform>
                                                    <RotateTransform Angle="0" />
                                                </Image.RenderTransform>
                                            </Image>
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked"
                                                 Value="False">
                                            <Setter TargetName="Chevron"
                                                    Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="-90" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ContentPresenter ContentSource="Header" />
                        </ToggleButton>
                        <ContentPresenter x:Name="ExpandSite"
                                          Visibility="Collapsed" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded"
                                 Value="True">
                            <Setter TargetName="ExpandSite"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ribbon-less pages keep a slim rail so the selected tab still meets a surface -->
    <Style x:Key="RibbonRail"
           TargetType="Border">
        <Setter Property="Height"
                Value="8" />
        <Setter Property="Background"
                Value="{StaticResource UiRibbonBrush}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource UiRuleBrush}" />
        <Setter Property="BorderThickness"
                Value="0,0,0,1" />
    </Style>

</ResourceDictionary>
