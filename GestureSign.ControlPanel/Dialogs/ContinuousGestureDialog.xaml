<controls:MetroWindow x:Class="GestureSign.ControlPanel.Dialogs.ContinuousGestureDialog"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
                      xmlns:localization="clr-namespace:GestureSign.Common.Localization;assembly=GestureSign.Common"
                      xmlns:common="clr-namespace:GestureSign.ControlPanel.Common"
                      FlowDirection="{StaticResource DefaultFlowDirection}"
                      BorderBrush="{StaticResource AccentColorBrush}"
                      BorderThickness="1"
                      ResizeMode="NoResize"
                      WindowStartupLocation="CenterOwner"
                      ShowIconOnTitleBar="False"
                      SizeToContent="Height"
                      Width="500">
    <controls:MetroWindow.Flyouts>
        <controls:FlyoutsControl>
            <controls:Flyout x:Name="MessageFlyout"
                             Theme="Accent"
                             Position="Bottom"
                             CloseButtonVisibility="Collapsed"
                             IsPinned="False"
                             Height="{Binding ElementName=MessageFlyoutText,Path=Height}">
                <TextBlock x:Name="MessageFlyoutText"
                           FontSize="16"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,10" />
            </controls:Flyout>
        </controls:FlyoutsControl>
    </controls:MetroWindow.Flyouts>
    <StackPanel>
        <StackPanel Margin="20,10,20,10">
            <!-- Name -->
            <TextBlock Text="{localization:LocalisedText ContinuousGesture.Name}"
                       FontSize="14"
                       FontWeight="Bold" />
            <TextBox x:Name="NameTextBox"
                     FontSize="14"
                     MaxLength="80"
                     Margin="0,5,0,0"
                     controls:TextBoxHelper.Watermark="{localization:LocalisedText ContinuousGesture.Dialog.NameWatermark}"
                     TextChanged="NameTextBox_TextChanged" />

            <!-- Motion -->
            <TextBlock Text="{localization:LocalisedText ContinuousGesture.Dialog.Motion}"
                       FontSize="14"
                       FontWeight="Bold"
                       Margin="0,15,0,0" />
            <TextBlock x:Name="MotionTextBlock"
                       HorizontalAlignment="Center"
                       FontSize="14"
                       Margin="0,5,0,0" />
            <Slider x:Name="FingersSlider"
                    common:SliderTools.MoveToPointOnDrag="True"
                    IsMoveToPointEnabled="True"
                    IsSnapToTickEnabled="True"
                    TickFrequency="1"
                    SmallChange="1"
                    LargeChange="1"
                    Minimum="2"
                    Maximum="10"
                    Value="3"
                    Margin="0,8,0,0"
                    ValueChanged="FingersSlider_ValueChanged" />
            <ListBox x:Name="DirectionListBox"
                     Margin="0,8,0,0"
                     SelectionMode="Single"
                     SelectedValuePath="Direction"
                     SelectionChanged="DirectionListBox_SelectionChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem"
                           BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="HorizontalContentAlignment"
                                Value="Center" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,8">
                            <Path Data="M7.41,15.41L12,10.83L16.59,15.41L18,14L12,8L6,14L7.41,15.41Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                  Stretch="Uniform"
                                  Width="22"
                                  Height="22"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="{Binding Angle}" />
                                </Path.RenderTransform>
                            </Path>
                            <TextBlock Text="{Binding Text}"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="MotionConflictTextBlock"
                       Foreground="{StaticResource UiDangerBrush}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0,5,0,0"
                       Visibility="Collapsed" />

            <!-- Bound actions -->
            <TextBlock Text="{localization:LocalisedText ContinuousGesture.Dialog.BoundActions}"
                       FontSize="14"
                       FontWeight="Bold"
                       Margin="0,15,0,0" />
            <Grid Margin="0,5,0,0">
                <ListBox x:Name="BindingListBox"
                         MinHeight="60"
                         MaxHeight="180"
                         BorderThickness="1"
                         BorderBrush="{StaticResource UiRuleBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem"
                               BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Click="RemoveBindingButton_Click"
                                        ToolTip="{localization:LocalisedText ContinuousGesture.Dialog.RemoveBinding}"
                                        Width="24"
                                        Height="24"
                                        MinWidth="0"
                                        MinHeight="0"
                                        Padding="0"
                                        Margin="6,0,0,0"
                                        Focusable="False">
                                    <Path Data="M0,0 L8,8 M8,0 L0,8"
                                          Stroke="{StaticResource UiMutedBrush}"
                                          StrokeThickness="1.4"
                                          Width="8"
                                          Height="8" />
                                </Button>
                                <TextBlock Text="{Binding Text}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text}" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{localization:LocalisedText ContinuousGesture.Dialog.NoBoundActions}"
                           Foreground="{StaticResource UiMutedBrush}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=BindingListBox, Path=HasItems}"
                                             Value="False">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="AppComboBox"
                          FontSize="13"
                          DisplayMemberPath="Name"
                          controls:TextBoxHelper.Watermark="{localization:LocalisedText ContinuousGesture.Dialog.Application}"
                          SelectionChanged="AppComboBox_SelectionChanged" />
                <ComboBox x:Name="ActionComboBox"
                          Grid.Column="1"
                          FontSize="13"
                          Margin="6,0,0,0"
                          DisplayMemberPath="Text"
                          controls:TextBoxHelper.Watermark="{localization:LocalisedText ContinuousGesture.Dialog.Action}"
                          SelectionChanged="ActionComboBox_SelectionChanged" />
                <Button x:Name="AddBindingButton"
                        Grid.Column="2"
                        Margin="6,0,0,0"
                        MinWidth="60"
                        FontSize="13"
                        IsEnabled="False"
                        Content="{localization:LocalisedText ContinuousGesture.Dialog.AddBinding}"
                        Click="AddBindingButton_Click" />
            </Grid>
            <TextBlock Text="{localization:LocalisedText ContinuousGesture.Dialog.ReplaceHint}"
                       Foreground="{StaticResource UiMutedBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,5,0,0" />
        </StackPanel>
        <Grid Height="35">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CancelButton"
                    Content="{localization:LocalisedText Common.Cancel}"
                    IsCancel="True"
                    FontSize="14" />
            <Button x:Name="OkButton"
                    Content="{localization:LocalisedText Common.OK}"
                    Click="OkButton_Click"
                    FontSize="14"
                    IsDefault="True"
                    Grid.Column="1" />
        </Grid>
    </StackPanel>
</controls:MetroWindow>
