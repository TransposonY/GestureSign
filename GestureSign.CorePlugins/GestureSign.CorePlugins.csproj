<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputPath>..\bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Title>CoreActions</Title>
    <Company>TransposonY</Company>
    <Product>CoreActions</Product>
    <Copyright>Copyright © TransposonY 2022</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\GestureSign.Common\GestureSign.Common.csproj" />
    <ProjectReference Include="..\ManagedWinapi\ManagedWinapi.csproj" />
    <ProjectReference Include="..\WindowsInput\WindowsInput.csproj" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Languages\*.xml" CopyToOutputDirectory="PreserveNewest" TargetPath="Languages\CorePlugins\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
