<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>GestureSign</AssemblyName>
    <RootNamespace>GestureSign.Daemon</RootNamespace>
    <Title>GestureSignDaemon</Title>
    <AssemblyTitle>GestureSignDaemon</AssemblyTitle>
    <Description>GestureSign Daemon</Description>
    <Company>TransposonY</Company>
    <Product>GestureSign</Product>
    <ApplicationIcon>Resources\normal.ico</ApplicationIcon>
    <ApplicationManifest>Properties\app.common.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(Configuration)' == 'uiAccessRelease'">Properties\app.uiAccessRelease.manifest</ApplicationManifest>
    <OutputPath>..\bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Centennial'">
    <DefineConstants>$(DefineConstants);ConvertedDesktopApp</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\GestureSign.Common\GestureSign.Common.csproj" />
    <ProjectReference Include="..\GestureSign.PointPatterns\GestureSign.PointPatterns.csproj" />
    <ProjectReference Include="..\ManagedWinapi\ManagedWinapi.csproj" />
    <ProjectReference Include="..\WindowsInput\WindowsInput.csproj" />
    <ProjectReference Include="..\GestureSign.CorePlugins\GestureSign.CorePlugins.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Languages\Daemon\*.xml" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Resources\normal.ico" />
    <EmbeddedResource Update="Properties\Resources.resx" Generator="ResXFileCodeGenerator" LastGenOutput="Resources.Designer.cs" />
    <Compile Update="Properties\Resources.Designer.cs" AutoGen="True" DesignTime="True" DependentUpon="Resources.resx" />
  </ItemGroup>
</Project>
